+#include <limits.h>
+#include <stdint.h>
 #include "node.h"
+
+/* Grow before an append; node counts and stored node indices remain ints. */
+static struct _node *reserve_node(struct _node **buffer, size_t *capacity,
+                                 int nn) {
+  struct _node *grown;
+  size_t limit, next_capacity;
+
+  if((size_t)nn < *capacity) return *buffer;
+  limit = SIZE_MAX/sizeof(struct _node);
+  if(limit > INT_MAX) limit = INT_MAX;
+  if(*capacity >= limit) {
+    fprintf(stderr, "Node capacity exceeds allocation or index limits\n\n");
+    exit(11);
+  }
+  next_capacity = *capacity > limit/2 ? limit : *capacity*2;
+  grown = (struct _node *)realloc(*buffer,
+                                next_capacity*sizeof(struct _node));
+  if(grown == NULL) {
+    fprintf(stderr, "Realloc failed on nodes\n\n");
+    exit(11);
+  }
+  memset(grown + *capacity, 0,
+         (next_capacity-*capacity)*sizeof(struct _node));
+  *buffer = grown;
+  *capacity = next_capacity;
+  return grown;
+}
 
